# Django core settings
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Supabase/PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSLMODE=require

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# Email / OTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com

# OTP Settings
OTP_EXPIRATION_MINUTES=10
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# Text.lk SMS API Settings
TEXT_LK_API_TOKEN=your_text_lk_api_token
TEXT_LK_SENDER_ID=your_text_lk_sender_id

# Supabase Storage Configuration (S3-compatible)
USE_S3=True
AWS_ACCESS_KEY_ID=your_supabase_access_key
AWS_SECRET_ACCESS_KEY=your_supabase_secret_key
AWS_PUBLIC_STORAGE_BUCKET_NAME=nexclinic-public
AWS_PRIVATE_STORAGE_BUCKET_NAME=nexclinic-private
AWS_S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=ap-northeast-1
