# ===========================
# NexAura Project .gitignore
# ===========================

# ============ FRONTEND (Next.js/React) ============

# dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
frontend/coverage/

# next.js
frontend/.next/
frontend/out/

# production
frontend/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local
frontend/.env*
!frontend/.env.local

# vercel
frontend/.vercel

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ============ BACKEND (Django/Python) ============

# Python
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
__pycache__/
*.py[cod]
*$py.class

# Django
backend/db.sqlite3
backend/db.sqlite3-journal
backend/*.log
backend/local_settings.py
backend/staticfiles/
backend/media/

# Virtual environments
.venv/
backend/venv/
backend/env/
backend/ENV/
backend/.venv/
venv/
env/
ENV/

# Distribution / packaging
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/share/python-wheels/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg
backend/MANIFEST

# PyInstaller
backend/*.manifest
backend/*.spec

# Unit test / coverage reports
backend/htmlcov/
backend/.tox/
backend/.nox/
backend/.coverage
backend/.coverage.*
backend/.cache
backend/nosetests.xml
backend/coverage.xml
backend/*.cover
backend/*.py,cover
backend/.hypothesis/
backend/.pytest_cache/
backend/cover/

# Django migrations (optional - uncomment if you don't want to track them)
# backend/*/migrations/*.py
# backend/*/migrations/*.pyc
# !backend/*/migrations/__init__.py

# Celery
backend/celerybeat-schedule
backend/celerybeat.pid

# Environments
backend/.env
backend/.env.*
backend/.venv

# mypy
backend/.mypy_cache/
backend/.dmypy.json
backend/dmypy.json

# Pyre
backend/.pyre/

# pytype
backend/.pytype/

# Cython
backend/cython_debug/

# ============ IDE & EDITORS ============

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============ OPERATING SYSTEMS ============

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============ LOGS & DATABASES ============

# Log files
*.log
logs/
log.txt

# Database files
*.sqlite
*.sqlite3
*.db

# ============ DOCUMENTATION & TEMP ============

# Temporary files
temp/
tmp/
*.tmp
*.bak
*.cache
temp-templates/

# Documentation builds
docs/_build/
docs/.doctrees/

# ============ MISC ============

# Security
*.pem
*.key
*.crt
*.cer

# Compiled
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Lock files (optional - uncomment to ignore)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Test coverage
coverage/
*.lcov
.nyc_output

# Cache
.cache/
.prettier-cache
.eslintcache

# Git
.git/
*.orig
