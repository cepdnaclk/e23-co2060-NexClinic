# NexClinic monorepo .gitignore

# -----------------------------
# Global OS / editor artifacts
# -----------------------------
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*.swn
*~
*.orig

# -----------------------------
# Secrets and env files
# -----------------------------
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# -----------------------------
# Frontend (Next.js / Node)
# -----------------------------
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.vercel/
frontend/*.tsbuildinfo

# JS logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.prettier-cache
.nyc_output/

# -----------------------------
# Backend (Django / Python)
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python

# Python environments (repo-wide)
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/
backend/ENV/

# Django runtime artifacts
backend/db.sqlite3
backend/db.sqlite3-journal
backend/*.log
backend/local_settings.py
backend/media/
backend/staticfiles/
backend/celerybeat-schedule
backend/celerybeat.pid

# Python tooling caches
backend/.pytest_cache/
backend/.mypy_cache/
backend/.dmypy.json
backend/dmypy.json
backend/.pyre/
backend/.pytype/
backend/.ruff_cache/
backend/.hypothesis/
backend/.tox/
backend/.nox/
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/coverage.xml

# Python packaging artifacts
backend/build/
backend/dist/
backend/*.egg-info/
backend/.eggs/
backend/*.egg
backend/pip-wheel-metadata/

# -----------------------------
# Docs, logs, temp files
# -----------------------------
docs/_build/
docs/.doctrees/
logs/
*.log
*.sqlite
*.sqlite3
*.db
tmp/
temp/
*.tmp
*.bak
*.cache

# Security artifacts
*.pem
*.key
*.crt
*.cer
